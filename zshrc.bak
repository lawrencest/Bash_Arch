# ~/.zshrc

# If not running interactively, don't do anything
[[ -o interactive ]] || return

# Source global zsh configurations if they exist
if [ -f /etc/zsh/zshrc ]; then
    . /etc/zsh/zshrc
fi

# Set up Starship prompt
eval "$(starship init zsh)"

# Aliases
alias fzfp='fzf --preview "bat --style=numbers --color=always {}" --preview-window right:50%'

# Basic settings
export EDITOR=nano  # Set default editor (change to vim, nvim, etc., if preferred)
export VISUAL="$EDITOR"

# History settings
HISTSIZE=1000
SAVEHIST=2000
HISTFILE=~/.zsh_history
setopt HIST_IGNORE_ALL_DUPS  # Don't save duplicate commands
setopt HIST_IGNORE_SPACE     # Don't save commands starting with space

# Enable color support for ls and grep
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
fi

# Add user-specific bin directory to PATH if it exists
if [ -d "$HOME/.local/bin" ]; then
    export PATH="$HOME/.local/bin:$PATH"
fi

# Enable Zsh completion
autoload -Uz compinit
compinit

# Improve completion behavior
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'  # Case-insensitive completion
zstyle ':completion:*' menu select                    # Interactive selection menu
